flowchart LR
    person["Usuario"]
    discord["Discord<br/>mezcla de voz"]
    cableIn["VB-CABLE<br/>CABLE Input"]
    cableOut["VB-CABLE<br/>CABLE Output"]
    guard["Discord Audio Guard<br/>captura + DSP + sincronización"]
    physical["Dispositivo físico<br/>auriculares / DAC"]
