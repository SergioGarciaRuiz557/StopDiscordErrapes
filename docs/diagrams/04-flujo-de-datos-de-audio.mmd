    encode["Pcm16Encoder<br/>float[] → byte[]"]
    ring["AdaptivePcmBuffer<br/>short L/R circular"]
    control["Control de ocupación<br/>ratio 0,995–1,005"]
    interpolation["Interpolación lineal<br/>fase fraccional"]
