flowchart TD
    launch["Arranque de aplicación"] --> exists{"¿Existe config.json?"}
    exists -->|"no"| defaults["ApplicationConfiguration.defaults()"]
    exists -->|"sí"| deserialize["Jackson deserializa records"]
    deserialize --> valid{"¿JSON y rangos válidos?"}
    valid -->|"sí"| memory["Snapshot de configuración en memoria"]
    valid -->|"no"| preserve["Renombra a config.corrupt-fecha.json"]
    preserve --> defaults
    defaults --> memory

    devices["Usuario selecciona dispositivos"] --> immutable["withDevices(...)"]
    dsp["Usuario cambia DSP"] --> immutable2["withProcessing(...)"]
    window["Cierre / geometría"] --> immutable3["withWindow(...)"]
    intro["Introducción mostrada"] --> immutable4["withFirstRun(false)"]

    immutable --> memory
    immutable2 --> memory
    immutable3 --> memory
    immutable4 --> memory

    memory --> save["Escribe config.json.tmp"]
    save --> atomic{"¿ATOMIC_MOVE disponible?"}
    atomic -->|"sí"| replace["Reemplazo atómico de config.json"]
    atomic -->|"no"| fallback["Reemplazo normal"]

